        <!-- Group 2: ROT3 -> ROT4          gap center x=508                     -->
        <!-- Group 3: ROT1 -> Stack-Input   gap center x=913                     -->

        <!-- Group 1: SO -> ROT5 (x=158..318) -->
        <mxCell id="fv-c1-jtag" value="J4 ERM8-005 -&gt; J3 ERF8-005 (JTAG)"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1e4d78;fontColor=#1e4d78;fontSize=9;" vertex="1" parent="fv-ms">
          <mxGeometry x="158" y="18" width="160" height="24" as="geometry" />
        </mxCell>
        <mxCell id="fv-c1-pwr" value="J5 ERM8-005 -&gt; J4 ERF8-005 (Power)"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#8f4a00;fontColor=#8f4a00;fontSize=9;" vertex="1" parent="fv-ms">
          <mxGeometry x="158" y="46" width="160" height="24" as="geometry" />
        </mxCell>
