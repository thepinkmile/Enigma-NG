        <!-- ===== Stack-Output board (left, tall vertical) ===== -->
        <mxCell id="fv-so" value="&lt;b&gt;Stack-Output&lt;/b&gt;&lt;br&gt;&lt;i&gt;(STAPELAUSGANG)&lt;/i&gt;&lt;br&gt;&lt;br&gt;receives from ROT 5:&lt;br&gt;J3 ERF8-005 (JTAG)&lt;br&gt;J4 ERF8-005 (Power)&lt;br&gt;J5 ERF8-010 (ENC data)"
