                style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="8" width="620" height="36" as="geometry" />
        </mxCell>
        <mxCell id="fv-sub" value="Front face = toward Cypher Board / previous mini-stack. ROT boards stand vertically on the rotor shaft; signal flows right-to-left (forward pass)."
