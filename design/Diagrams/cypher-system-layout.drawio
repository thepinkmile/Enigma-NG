                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#00662a;fontColor=#00662a;fontSize=9;" vertex="1" parent="fv-ms">
          <mxGeometry x="158" y="74" width="160" height="24" as="geometry" />
        </mxCell>
        <!-- vertical connector from labels to gap -->
        <mxCell id="fv-c1-vl" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="fv-ms">
          <mxGeometry relative="1" as="geometry"><mxPoint x="238" y="98" as="sourcePoint"/><mxPoint x="238" y="120" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Group 2: ROT3 -> ROT4 (x=428..588) -->
        <mxCell id="fv-c2-jtag" value="J4 -&gt; J1  ERM8-005 (JTAG)"
