                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="fv-ms">
          <mxGeometry x="10" y="250" width="82" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fv-so-j1e" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.29;" edge="1" source="fv-so-j1" target="fv-so" parent="fv-ms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fv-so-j2" value="J2 QSS-025&lt;br&gt;(rear stacking 50-pin)&lt;br&gt;&lt;i&gt;exits right &amp;rarr; Stack-Blanking&lt;/i&gt;"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;" vertex="1" parent="fv-ms">
          <mxGeometry x="10" y="308" width="82" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fv-so-j2e" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.52;" edge="1" source="fv-so-j2" target="fv-so" parent="fv-ms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Stack-Input board (right, tall vertical) ===== -->
        <mxCell id="fv-si" value="&lt;b&gt;Stack-Input&lt;/b&gt;&lt;br&gt;&lt;i&gt;(STAPELEINGANG)&lt;/i&gt;&lt;br&gt;&lt;br&gt;drives to ROT 1:&lt;br&gt;J3 ERF8-005 (JTAG)&lt;br&gt;J4 ERF8-005 (Power)&lt;br&gt;J5 ERF8-010 (ENC data)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;" vertex="1" parent="fv-ms">
          <mxGeometry x="940" y="196" width="110" height="290" as="geometry" />
        </mxCell>
        <mxCell id="fv-si-j1" value="J1 QTS-025&lt;br&gt;(front stacking 50-pin)&lt;br&gt;&lt;i&gt;exits right &amp;rarr; Cypher Board&lt;/i&gt;"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="fv-ms">
          <mxGeometry x="1058" y="250" width="82" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fv-si-j1e" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;exitX=0;exitY=0.5;entryX=1;entryY=0.29;" edge="1" source="fv-si-j1" target="fv-si" parent="fv-ms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fv-si-j2" value="J2 QSS-025&lt;br&gt;(rear stacking 50-pin)&lt;br&gt;&lt;i&gt;exits left &amp;rarr; Stack-Blanking&lt;/i&gt;"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;" vertex="1" parent="fv-ms">
          <mxGeometry x="1058" y="308" width="82" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fv-si-j2e" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;exitX=0;exitY=0.5;entryX=1;entryY=0.52;" edge="1" source="fv-si-j2" target="fv-si" parent="fv-ms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== Rotor shaft ===== -->
        <!-- ROT boards: y=106, h=350, centre y=106+175=281; shaft at y=273 -->
        <mxCell id="fv-shaft" value="Rotor Shaft"
                style="rounded=0;whiteSpace=wrap;html=1;fillColor=#555555;strokeColor=#222222;fontColor=#ffffff;fontSize=9;fontStyle=1;" vertex="1" parent="fv-ms">
          <mxGeometry x="210" y="273" width="730" height="16" as="geometry" />
        </mxCell>

        <!-- ===== ROT boards (5x, narrow vertical)              =====  -->
        <!-- Stack-Output right=210; gaps=55; ROT width=80              -->
        <!-- ROT5=265-345  ROT4=400-480  ROT3=535-615  ROT2=670-750  ROT1=805-885 -->
        <!-- gap to SI: 940-885=55 ✓                                    -->
        <mxCell id="fv-rot5" value="&lt;b&gt;ROT 5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="fv-ms">
          <mxGeometry x="265" y="106" width="80" height="350" as="geometry" />
        </mxCell>
        <mxCell id="fv-rot4" value="&lt;b&gt;ROT 4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="fv-ms">
          <mxGeometry x="400" y="106" width="80" height="350" as="geometry" />
        </mxCell>
        <mxCell id="fv-rot3" value="&lt;b&gt;ROT 3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="fv-ms">
          <mxGeometry x="535" y="106" width="80" height="350" as="geometry" />
        </mxCell>
        <mxCell id="fv-rot2" value="&lt;b&gt;ROT 2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="fv-ms">
          <mxGeometry x="670" y="106" width="80" height="350" as="geometry" />
        </mxCell>
        <mxCell id="fv-rot1" value="&lt;b&gt;ROT 1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="fv-ms">
          <mxGeometry x="805" y="106" width="80" height="350" as="geometry" />
        </mxCell>

        <!-- 3 representative connector arrows in gaps (thin, at y=120) -->
        <!-- Gap 1: SO(right=210) to ROT5(left=265) -->
        <mxCell id="fv-a1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444444;" edge="1" parent="fv-ms">
          <mxGeometry relative="1" as="geometry"><mxPoint x="265" y="120" as="sourcePoint"/><mxPoint x="210" y="120" as="targetPoint"/></mxGeometry>
        </mxCell>
        <!-- Gap 2: ROT3(right=615) to ROT4(left=535... wait ROT3 is at x=535, ROT4 at x=400) -->
        <!-- Signal flows right-to-left: ROT3 output goes LEFT to ROT4 -->
        <!-- ROT3 left=535, ROT4 right=480; arrow from x=535 to x=480 -->
        <mxCell id="fv-a2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444444;" edge="1" parent="fv-ms">
          <mxGeometry relative="1" as="geometry"><mxPoint x="535" y="120" as="sourcePoint"/><mxPoint x="480" y="120" as="targetPoint"/></mxGeometry>
        </mxCell>
        <!-- Gap 3: SI(left=940) to ROT1(right=885) -->
        <mxCell id="fv-a3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444444;" edge="1" parent="fv-ms">
          <mxGeometry relative="1" as="geometry"><mxPoint x="940" y="120" as="sourcePoint"/><mxPoint x="885" y="120" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Signal flow note -->
        <mxCell id="fv-sflow" value="&lt;b&gt;Signal flow (forward pass):&lt;/b&gt; Stack-Input (J3/J4/J5) -&gt; (J1/J2/J3) ROT 1 (J4/J5/J6) -&gt; (J1/J2/J3) ROT 2 (J4/J5/J6) -&gt; (J1/J2/J3) ROT 3 (J4/J5/J6) -&gt; (J1/J2/J3) ROT 4 (J4/J5/J6) -&gt; (J1/J2/J3) ROT 5 (J4/J5/J6) -&gt; (J3/J4/J5) Stack-Output&lt;br&gt;&lt;b&gt;Signal flow (to-reflector):&lt;/b&gt; Stack-Output (J6) -&gt; (J1) Stack-Interposer (J2) -&gt; (J6) Stack-Input (J2) -&gt; Stack-Blanking -&gt; (J2) Stack-Output (J1) -&gt; Cypher&lt;br&gt;&lt;b&gt;Signal flow (from-reflector):&lt;/b&gt; Cypher -&gt; (J1) Stack-Output (J2) -&gt; Stack-Blanking -&gt; (J2) Stack-Input (J6) -&gt; (J2) Stack-Interposer (J1) -&gt; (J6) Stack-Output&lt;br&gt;&lt;b&gt;Signal flow (reverse pass):&lt;/b&gt; Stack-Output (J3/J4/J5) -&gt; (J4/J5/J6) ROT 5 (J1/J2/J3) -&gt; (J4/J5/J6) ROT 4 (J1/J2/J3) -&gt; (J4/J5/J6) ROT 3 (J1/J2/J3) -&gt; (J4/J5/J6) ROT 2 (J1/J2/J3) -&gt; (J4/J5/J6) ROT 1 (J1/J2/J3) -&gt; (J3/J4/J5) Stack-Input"
                style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;" vertex="1" parent="fv-ms">
          <mxGeometry x="100" y="616" width="950" height="80" as="geometry" />
        </mxCell>

        <!-- ===== Stack-Interposer board ===== -->
        <mxCell id="fv-sint"
                value="&lt;b&gt;Stack-Interposer Board (STAPELBRUCKE)&lt;/b&gt;&lt;br&gt;J1 TMMH-115-01-L-D-ES (Stack-Output side) &amp;mdash; mates with Stack-Output J6 SQT-115-01-L-D-RA&lt;br&gt;J2 TMMH-115-01-L-D-ES (Stack-Input side) &amp;mdash; mates with Stack-Input J6 SQT-115-01-L-D-RA&lt;br&gt;Carries: SIG-BLOCK-A (ENC_DATA[5:0] fwd) &amp;middot; SIG-BLOCK-D (ENC_DATA[5:0] return) &amp;middot; SIG-BLOCK-E (TTD)"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="fv-ms">
          <mxGeometry x="100" y="508" width="950" height="82" as="geometry" />
        </mxCell>

        <!-- J6 connections: board bottoms to interposer -->
        <mxCell id="fv-j6-so" value="J6 SQT-115-01-L-D-RA"
                style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;fontSize=9;" edge="1" source="fv-so" target="fv-sint" parent="fv-ms">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="496"/><mxPoint x="155" y="508"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="fv-j6-si" value="J6 SQT-115-01-L-D-RA"
