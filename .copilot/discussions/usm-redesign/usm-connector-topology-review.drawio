<mxfile host="65bd71144e">
    <diagram id="usm-topology" name="USM Connector Topology - DRAFT">
        <mxGraphModel dx="1490" dy="826" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="USM Redesign — Connector Topology Review (DRAFT, pending user confirmation, 2026-09-16)" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="legendBox" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="60" width="280" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="legend1" value="Blue = unchanged left-pair chain&#xa;(ENC_DATA / 5V_MAIN / GND / BOARD_ROLE_ID)&#xa;— straight through, USM not involved" style="text;strokeColor=none;fillColor=none;fontSize=11;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="90" width="260" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="legend2" value="Orange = relocated right-pair chain&#xa;(3V3_ENIG / JTAG / I2C)&#xa;— now routed via USM, not board-to-board" style="text;strokeColor=none;fillColor=none;fontSize=11;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="140" width="260" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="legend3" value="ENC_DATA never reaches USM at all" style="text;strokeColor=none;fillColor=none;fontSize=11;align=left;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="185" width="260" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="cypher" value="Cypher Board&#xa;(J5 = left, J6 = right, per Cypher/Board_Layout.md §4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="65" width="1000" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="input" value="Cypher-Input&#xa;(example: HID-Top position)&#xa;&#xa;KBD_ENC ENC module CPLD:&#xa;- reads 3 stored colour values (I2C)&#xa;- generates addressable LED protocol&#xa;  locally using real-time key state&#xa;- needs more LEs (MAX10 candidate)&#xa;&#xa;U4 (PCA9534A) stays local:&#xa;Space/Enter UI-only keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=20;verticalAlign=top;fontStyle=1;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="130" y="280" width="320" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="output" value="Cypher-Output&#xa;(example: HID-Bottom position)&#xa;&#xa;LBD_DEC ENC module CPLD:&#xa;- reads 3 stored colour values (I2C)&#xa;- decodes case (upper/lower) from&#xa;  ENC_DATA[5:0] to pick Colour2/3&#xa;- generates addressable LED protocol&#xa;  locally; blank when no key active&#xa;- needs more LEs (MAX10 candidate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=20;verticalAlign=top;fontStyle=1;spacingTop=1;" parent="1" vertex="1">
                    <mxGeometry x="130" y="530" width="320" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="plugboard" value="Cypher-Plugboard&#xa;(J1 = left, J2 = right)&#xa;JTAG spoke terminator (R1-R3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="840" width="1000" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="usm" value="User Settings Module (USM)&#xa;— repurposed as shared LED/colour hub —&#xa;&#xa;- Stores 3x RGB colour values&#xa;  (CM5-configured, infrequent writes)&#xa;- Holds RV1 brightness dial&#xa;- Relays 3V3_ENIG / JTAG / I2C only&#xa;  (never sees ENC_DATA)&#xa;- Piezo buzzer / speaker (TBD - see&#xa;  usm-buzzer-audio-options todo)&#xa;- No physical config switches at all&#xa;  (CFG_ROUTE/CFG_REFMAP fully CM5-driven)&#xa;&#xa;4 connectors total:&#xa;TOP → Cypher Board&#xa;LEFT-UPPER → whichever HID board is on top&#xa;LEFT-LOWER → whichever HID board is on bottom&#xa;BOTTOM → Cypher-Plugboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=30;verticalAlign=top;fontStyle=1;spacingTop=25;" parent="1" vertex="1">
                    <mxGeometry x="670" y="280" width="370" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="J5↔J4: ENC_DATA[5:0] / 5V_MAIN / GND / BOARD_ROLE_ID" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontStyle=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" parent="1" source="cypher" target="input" edge="1">
                    <mxGeometry x="0.0769" relative="1" as="geometry">
                        <mxPoint x="100" y="140" as="sourcePoint"/>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e2" value="J6↔J4: ENC_DATA / 5V_MAIN / GND / BOARD_ROLE_ID passthrough" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontStyle=1;" parent="1" source="input" target="output" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="J6↔J1: ENC_DATA / 5V_MAIN / GND / BOARD_ROLE_ID (dead-ends, unused by Plugboard)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontStyle=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" parent="1" source="output" target="plugboard" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="60" y="830" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e4" value="J6↔USM-TOP: 3V3_ENIG / JTAG / I2C" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;fontColor=#d79b00;fontStyle=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" parent="1" source="cypher" target="usm" edge="1">
                    <mxGeometry x="-0.5714" relative="1" as="geometry">
                        <mxPoint x="770" y="180" as="sourcePoint"/>
                        <mxPoint y="-1" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e5" value="NEW right-edge connector&lt;br&gt;USM-LEFT-UPPER&lt;br&gt;3V3_ENIG / JTAG / I2C" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;fontColor=#d79b00;fontStyle=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" parent="1" source="input" target="usm" edge="1">
                    <mxGeometry x="-0.04" y="-40" relative="1" as="geometry">
                        <mxPoint x="40" y="-40" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e6" value="NEW right-edge connector&lt;br&gt;USM-LEFT-LOWER&lt;br&gt;3V3_ENIG / JTAG / I2C" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;fontColor=#d79b00;fontStyle=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" parent="1" source="output" target="usm" edge="1">
                    <mxGeometry x="0.1899" y="43" relative="1" as="geometry">
                        <mxPoint y="1" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e7" value="&lt;span style=&quot;color: rgb(215, 155, 0);&quot;&gt;J2&lt;/span&gt;&lt;span style=&quot;color: rgb(215, 155, 0);&quot;&gt;↔&lt;/span&gt;USM-BOTTOM: 3V3_ENIG / JTAG (spoke terminates, R1-R3) / I2C" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;fontColor=#d79b00;fontStyle=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" parent="1" source="usm" target="plugboard" edge="1">
                    <mxGeometry x="-0.6098" y="5" relative="1" as="geometry">
                        <mxPoint x="870" y="770" as="targetPoint"/>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="mechNote" value="Mechanical concept: Cypher-Input + Cypher-Output + USM form one physical &quot;3-part HID module&quot;&#xa;(2 boards stacked vertically on the left, USM rotated 90° on the right spanning their combined height),&#xa;screwed down onto the enclosure top, just in front of the Rotor Stacks." style="text;strokeColor=none;fillColor=none;fontSize=12;align=left;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="200" y="960" width="840" height="50" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>